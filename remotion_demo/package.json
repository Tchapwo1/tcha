{
  "name": "agentshield-remotion-demo",
  "version": "1.0.0",
  "description": "30-second high-energy programmatic product teaser for AgentShield",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts AgentShieldDemo out/agentshield_teaser.mp4 --concurrency=1 --gl=angle --codec=h264 --pixel-format=yuv420p"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.245"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.245",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
